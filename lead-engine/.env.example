# pluszehn Lead-Engine — Konfiguration
# Kopiere diese Datei zu ".env" und trage deine Schlüssel ein.
# Ohne Schlüssel läuft alles im Demo-Modus (Region-Bühl-Beispieldaten + Vorlagen-Mails).

# Google Places API (New) — für echte Betriebe + Bewertungen von Google Maps.
# Aktiviere "Places API (New)" in der Google Cloud Console und erstelle einen API-Key.
GOOGLE_MAPS_API_KEY=

# Anthropic / Claude — für individuell geschriebene Akquise-Mails.
# Key unter https://console.anthropic.com erstellen.
ANTHROPIC_API_KEY=
# Optional anderes Modell (Standard: claude-opus-4-8). Günstiger bei Masse: claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-4-8

# Port (Standard 4010)
PORT=4010
