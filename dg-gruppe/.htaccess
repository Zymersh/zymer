# Apache-Konfiguration (z. B. IONOS, Strato, All-Inkl). Bei Netlify/Vercel/Nginx entsprechend übertragen.

ErrorDocument 404 /404.html

# HTTPS + ohne www erzwingen
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://dg-gebaeudedienstleister.de%{REQUEST_URI} [L,R=301]

# Alte WordPress-URLs → neue Seiten (Rankings behalten). Liste vor Go-Live mit
# der vollständigen alten Sitemap (/wp-sitemap.xml bzw. /sitemap_index.xml) abgleichen.
RewriteRule ^home/?$ / [L,R=301]
RewriteRule ^about/?$ /#ueber-uns [L,R=301,NE]
RewriteRule ^ueber-uns-heilbronn/?$ /#ueber-uns [L,R=301,NE]
RewriteRule ^kontakt-heilbronn/?$ /#kontakt [L,R=301,NE]
RewriteRule ^gebaeudereiniger-stellenangebote-bruchsal/?$ /karriere.html [L,R=301]
RewriteRule ^(gebaudereinigung|gebaeudereinigung-heilbronn|reinigungsfirma-heilbronn|bueroreinigung-heilbronn|baureinigung-heilbronn|sonderreinigung-bruchsal|facility-management-heilbronn|heilbronn|leistungen/[^/]+)/?$ /#leistungen [L,R=301,NE]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  <FilesMatch "\.(woff2|svg|png|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json application/manifest+json
</IfModule>
